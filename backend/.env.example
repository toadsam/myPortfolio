DATABASE_URL=sqlite:///./portfolio_village.db
FRONTEND_ORIGIN=http://localhost:3000

# Optional. If omitted, NPCs use portfolio-data fallback replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_NPC_MODEL=gpt-5-nano

# Optional. If omitted, /github/sync returns a clear warning and stores 0 commits.
GITHUB_TOKEN=
GITHUB_USERNAME=toadsam
LOCAL_TIMEZONE=Asia/Seoul

# ── 보안 (배포 전 반드시 설정) ──
# ADMIN_PASSWORD 가 비어 있으면 /admin 인증이 비활성(로컬 개발 편의).
# 배포 시 반드시 강한 비밀번호를 넣을 것 — 안 넣으면 누구나 기록을 수정/삭제할 수 있음!
ADMIN_PASSWORD=
# 로그인 토큰 서명용 비밀키 — 길고 무작위한 값으로 교체할 것.
ADMIN_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN_TTL_HOURS=168

# ── AI 레이트리밋 (비용/남용 방지) ──
AI_RATE_PER_MIN=30
AI_DAILY_LIMIT=800

# ── 의뢰 공방 (홈페이지 제작 의뢰 접수) ──
# 새 의뢰가 접수되면 이 웹훅으로 알림이 간다. 비워 두면 알림을 조용히 건너뛴다
# (접수 자체는 정상 동작하지만, 관리자 페이지를 열기 전까지 새 의뢰를 모르게 된다).
# 디스코드: 서버 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=
# 접수 남용 방지 — AI 리밋과 별개다. 뚫리면 비용이 아니라 받은편지함이 망가진다.
# RATE_PER_HOUR 는 '성공한' 접수만, ATTEMPTS_PER_HOUR 는 시도 전체를 센다.
# (이메일 오타 재시도로 멀쩡한 손님이 잠기지 않게 둘을 분리했다.)
COMMISSION_RATE_PER_HOUR=3
COMMISSION_ATTEMPTS_PER_HOUR=20
COMMISSION_DAILY_LIMIT=40
