{
  "homepage": "https://toadsam.github.io/myPortfolio/",
  "name": "ai-portfolio-village",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "backend:dev": "node scripts/backend-dev.mjs",
    "atelier": "node scripts/atelier-worker.mjs",
    "optimize": "node scripts/optimize-glb.mjs",
    "merge-character": "node scripts/merge-character.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "resume:pdf": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/ts-loader.mjs scripts/build-public-resume-pdf.mjs",
    "check:village": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/ts-loader.mjs scripts/check-village.mjs",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,css,json,md}\"",
    "check-format": "prettier -c \"./**/*.{js,jsx,ts,tsx,css,json,md}\"",
    "optimize:webp": "node scripts/compress-glb-webp.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "framer-motion": "12.42.0",
    "next": "16.2.9",
    "postprocessing": "^6.39.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.183.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.0",
    "autoprefixer": "10.5.2",
    "postcss": "8.5.15",
    "prettier": "^2.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  }
}
